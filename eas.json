{
  "cli": {
    "version": ">= 10.2.1",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED": "true"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_FIREBASE_APP_CHECK_ENABLED": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
